# LoL Data Hub - 环境变量配置示例
# 复制本文件为 .env 并填入实际值
# cp .env.example .env

# ---- 端口配置 ----
# 注意：MySQL、Redis 和后端端口仅绑定 127.0.0.1，不暴露到外部网络
FRONTEND_PORT=8081
BACKEND_PORT=8080
MYSQL_PORT=3307
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MySQL（默认值仅适合本地开发） ----
MYSQL_DATABASE=lol_data_hub
MYSQL_USERNAME=loldatahub
MYSQL_PASSWORD=loldatahub
MYSQL_ROOT_PASSWORD=root

# ---- 官网数据采集凭据（必填） ----
# 从 tjstats.com 前端请求头中获取 Authorization 值
# 注意：不要将真实凭据提交到版本控制
TJSTATS_AUTHORIZATION=
TJSTATS_BASE_URL=https://open.tjstats.com/match-auth-app/open/v1

# ---- 内部接口访问令牌（手动同步/采集必填） ----
# 用于 /api/internal/ 路径的 Token 鉴权；为空时内部接口返回 503 不可用
# 建议使用 32 字节以上随机字符串，如：openssl rand -hex 32
# 注意：不要将真实令牌提交到版本控制
INTERNAL_API_TOKEN=
